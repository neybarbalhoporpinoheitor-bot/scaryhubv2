-- ESP
createButton("ESP", "ESP", UDim2.new(0, 210, 0, 60), function()
    local highlights = {}

    local function createHighlight(character)
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        if highlights[character] then return end

        local h = Instance.new("BoxHandleAdornment")
        h.Adornee = character.HumanoidRootPart
        h.AlwaysOnTop = true
        h.ZIndex = 10
        h.Size = Vector3.new(4, 6, 1)
        h.Color3 = Color3.new(1, 0, 0)
        h.Transparency = 0.5
        h.Parent = character

        highlights[character] = h
    end

    local function update()
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                createHighlight(player.Character)
            end
        end
    end

    if _G.ESPConnection then
        _G.ESPConnection:Disconnect()
        _G.ESPConnection = nil
    else
        _G.ESPConnection = RunService.RenderStepped:Connect(update)
    end
end)

-- NOCLIP
local noclip = false
local conn

createButton("Noclip", "Noclip: OFF", UDim2.new(0, 20, 0, 110), function(btn)
    noclip = not noclip
    btn.Text = noclip and "Noclip: ON" or "Noclip: OFF"
    btn.BackgroundColor3 = noclip and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)

    if noclip then
        conn = RunService.Stepped:Connect(function()
            for _, p in ipairs(LocalPlayer.Character:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end)
    else
        if conn then conn:Disconnect() end
    end
end)

