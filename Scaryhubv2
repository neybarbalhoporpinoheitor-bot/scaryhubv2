local playerList = Instance.new("ScrollingFrame", tpGui)
playerList.Size = UDim2.new(1, 0, 1, -30)
playerList.Position = UDim2.new(0, 0, 0, 30)
playerList.BackgroundTransparency = 1
playerList.CanvasSize = UDim2.new(0, 0, 0, 0)
playerList.ScrollBarThickness = 6
playerList.AutomaticCanvasSize = Enum.AutomaticSize.Y

local function updatePlayerList()
    playerList:ClearAllChildren()
    local y = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local btn = Instance.new("TextButton", playerList)
            btn.Size = UDim2.new(1, -10, 0, 30)
            btn.Position = UDim2.new(0, 5, 0, y)
            btn.Text = player.Name
            btn.BackgroundColor3 = Color3.new(1, 0, 0)
            btn.TextColor3 = Color3.new(0, 0, 0)
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 14
            Instance.new("UICorner", btn)

            btn.MouseButton1Click:Connect(function()
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character:MoveTo(player.Character.HumanoidRootPart.Position + Vector3.new(2, 0, 2))
                end
            end)

            y = y + 35
        end
    end
end

Players.PlayerAdded:Connect(updatePlayerList)
Players.PlayerRemoving:Connect(updatePlayerList)

createButton("TPPlayers", "TP Players", UDim2.new(0, 210, 0, 10), function(btn)
    tpGui.Visible = not tpGui.Visible
    btn.Text = tpGui.Visible and "Fechar TP" or "TP Players"
    updatePlayerList()
end)

